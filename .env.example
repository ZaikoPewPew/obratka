# Supabase (anon / publishable — можно в клиенте)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Telegram Login Widget (публичные)
# BotFather → token: число до двоеточия = BOT_ID
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=

# PostHog (project token — публичный, как anon; не personal API key)
# Project settings → Project API Key / Host
# US: https://us.i.posthog.com · EU: https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# TELEGRAM_BOT_TOKEN — только в Supabase Edge Function secrets, не сюда

# Google OAuth — без клиентских env: Client ID/Secret только в
# Supabase Dashboard → Authentication → Providers → Google.
# Email OTP — там же → Providers → Email (включить; Magic Link + Confirm signup: {{ .Token }}).
# Automatic linking Email↔Google — из коробки; Manual linking не включать без UI.
# Redirect URLs: http://localhost:5173/, http://127.0.0.1:5173/, https://zaikopewpew.github.io/obratka/
# Проверка: node --env-file=.env scripts/verify-email-otp-setup.mjs
# (см. src/components/auth-screen/README.md)
